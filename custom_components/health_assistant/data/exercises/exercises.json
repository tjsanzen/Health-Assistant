  "lateral_raise_cable": {
    "name": "Lateral Raise (Cable)",
    "muscle": "Shoulders",
    "secondary": [
      "Traps"
    ],
    "equipment": "Cable",
    "kind": "weight_reps",
    "tier": 4,
    "instructions": [
      "Set a single cable pulley to its lowest position and attach a D-handle.",
      "Stand side-on to the machine and grab the handle with your far hand, cable running across the front of your body.",
      "With a slight bend in the elbow, raise your arm out to the side until it is level with your shoulder.",
      "Pause briefly at the top, then lower slowly under control. Finish all reps, then switch sides."
    ],
    "tips": [
      "Lead with the elbow, not the hand.",
      "Keep your torso still — no swinging."
    ],
    "demo": "lateral_raise_cable.gif"
